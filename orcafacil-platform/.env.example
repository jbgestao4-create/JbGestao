# ==============================================================================
# INTEGRAÇÃO MERCADO PAGO - PAGAMENTOS PIX & WEBHOOK AUTOMÁTICO
# ==============================================================================
# Access Token Oficial do Mercado Pago (Sandbox: TEST-... | Produção: APP_USR-...)
# Pode ser configurado aqui ou diretamente na interface em Configurações do Sistema.
MERCADO_PAGO_ACCESS_TOKEN=

# Chave Pública (Public Key)
